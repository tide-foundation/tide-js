{
  "name": "tide-load-harness",
  "version": "0.1.0",
  "description": "Load-test harness for the Tide network. Imports @tideorg/js to drive real protocol traffic from a Node server callable by Locust.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "warmup": "node dist/warmup/index.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@tideorg/js": "file:..",
    "express": "^4.21.0",
    "playwright": "^1.48.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.5.0"
  }
}
